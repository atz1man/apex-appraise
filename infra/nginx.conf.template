server {
  listen 80;
  root /usr/share/nginx/html;
  index index.html;

  # Compress text assets — the main bundle drops ~70% over the wire
  gzip on;
  gzip_comp_level 6;
  gzip_min_length 1024;
  gzip_vary on;
  gzip_types text/css application/javascript application/json image/svg+xml
             application/manifest+json font/ttf font/otf;

  location /trpc/ {
    proxy_pass http://${API_UPSTREAM};
    proxy_set_header Host $host;
    include /etc/nginx/client-ip.conf;
  }

  # ^~ matters: without it the .png/.webp regex location below wins over this
  # prefix match, and every uploaded image — logos, site photos — 404s against
  # the static root in production while working fine behind vite in dev.
  location ^~ /uploads/ {
    proxy_pass http://${API_UPSTREAM};
    proxy_set_header Host $host;
    include /etc/nginx/client-ip.conf;
    client_max_body_size 100m;
  }

  # The public API. Without this, /api/v1/... falls through to the SPA and an
  # integrator receives index.html with HTTP 200 — a failure that looks exactly
  # like success, which is the worst kind to ship.
  location /api/ {
    proxy_pass http://${API_UPSTREAM};
    proxy_set_header Host $host;
    include /etc/nginx/client-ip.conf;
  }

  # public read-only report links — rendered by the API, same timeout as /reports/
  location /shared/ {
    proxy_pass http://${API_UPSTREAM};
    proxy_set_header Host $host;
    include /etc/nginx/client-ip.conf;
    proxy_read_timeout 120s;
  }

  location /reports/ {
    proxy_pass http://${API_UPSTREAM};
    proxy_set_header Host $host;
    include /etc/nginx/client-ip.conf;
    proxy_read_timeout 120s;
  }

  # Map tiles, proxied by the API so no visitor's browser talks to a tile server.
  # ^~ because the .png regex location below would otherwise win and try to serve
  # these off the web image's disk, where no tile has ever existed.
  location ^~ /tiles/ {
    proxy_pass http://${API_UPSTREAM};
    proxy_set_header Host $host;
    include /etc/nginx/client-ip.conf;
    # the API answers these with immutable max-age; nginx must not overwrite it
    proxy_read_timeout 30s;
  }

  # Liveness and readiness, proxied to the API.
  #
  # Exact-match (`= /path`) so they beat the SPA fallback outright. Without these
  # blocks both fell through to `location /`, which does `try_files $uri
  # /index.html` — so a monitor asking the PUBLIC url for /ready got the React
  # shell with a 200 and reported the service healthy while the API and the
  # database were both dead. That is the same lie the old /health told, moved one
  # layer out, and it is the one an uptime check would actually have hit.
  location = /health {
    proxy_pass http://${API_UPSTREAM};
    proxy_set_header Host $host;
    include /etc/nginx/client-ip.conf;
  }

  location = /ready {
    proxy_pass http://${API_UPSTREAM};
    proxy_set_header Host $host;
    include /etc/nginx/client-ip.conf;
    # `always`, or nginx applies this only to 2xx/3xx — and the response that
    # most needs never to be cached is the 503
    add_header Cache-Control "no-store" always;
  }

  location /webhooks/ {
    proxy_pass http://${API_UPSTREAM};
    proxy_set_header Host $host;
    include /etc/nginx/client-ip.conf;
  }

  # Nightly demo reset (token-guarded in the API; api app is flycast-only)
  location /admin/ {
    proxy_pass http://${API_UPSTREAM};
    proxy_set_header Host $host;
    include /etc/nginx/client-ip.conf;
    proxy_read_timeout 120s;
  }

  # Hashed build assets never change — cache forever
  location /assets/ {
    add_header Cache-Control "public, max-age=31536000, immutable";
    try_files $uri =404;
  }

  # Self-hosted typefaces. Their names carry no content hash — the service worker
  # precaches them by path and index.html preloads them by path, both of which
  # need a name that survives a build — so they are cached hard and REPLACED BY
  # RENAMING. Changing the bytes under an existing name would leave year-old
  # copies in browsers that already hold one; ship a new face as a new filename.
  location ^~ /fonts/ {
    add_header Cache-Control "public, max-age=31536000, immutable";
    try_files $uri =404;
  }

  # Static icons/manifest: a day is plenty (stable names, contents rarely change)
  location ~* \.(png|webp|svg|webmanifest|txt)$ {
    add_header Cache-Control "public, max-age=86400";
    try_files $uri /index.html;
  }

  location / {
    # index.html must revalidate so new deploys land immediately
    add_header Cache-Control "no-cache";
    try_files $uri /index.html;
  }
}
