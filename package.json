{
  "name": "apex-appraise",
  "private": true,
  "version": "0.1.0",
  "description": "Apex Appraise \u2014 connected operating system for UK residential & mixed-use property development",
  "scripts": {
    "dev": "pnpm --parallel --filter @apex/api --filter @apex/web dev",
    "dev:api": "pnpm --filter @apex/api dev",
    "dev:web": "pnpm --filter @apex/web dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "seed": "pnpm --filter @apex/api seed",
    "db:push": "pnpm --filter @apex/api db:push",
    "release:check": "pnpm --filter @apex/api exec tsx ../../infra/check-release.ts"
  },
  "packageManager": "pnpm@9.15.0",
  "pnpm": {
    "overrides": {
      "fast-uri@<3.1.8": "3.1.8",
      "find-my-way@<9.7.0": "9.7.0",
      "brace-expansion@1": "1.1.21",
      "brace-expansion@2": "2.1.7",
      "brace-expansion@5": "5.0.12",
      "@fastify/busboy@<3.2.2": "3.2.2",
      "proxy-addr@<2.0.8": "2.0.8",
      "ip-address@<10.7.1": "10.7.1",
      "hono@<4.13.7": "4.13.7",
      "uuid@<11.1.1": "11.1.1"
    }
  }
}
