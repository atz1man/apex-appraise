{
  "name": "kept",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Kept — local-first UK return-deadline tracker (PWA + landing page)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "TZ=America/New_York vitest run",
    "smoke": "node scripts/smoke.mjs",
    "icons": "node scripts/make-icons.mjs",
    "contrast": "node scripts/contrast.mjs",
    "a11y": "node scripts/a11y.mjs",
    "layout": "node scripts/layout.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "axe-core": "^4.13.0",
    "playwright": "^1.62.1",
    "typescript": "^5.6.3",
    "vite": "^7.3.6",
    "vitest": "^3.2.7",
    "wait-on": "^9.1.0"
  }
}
