// Apex Appraise — Prisma schema (DATA_MODEL.md).
// Dev uses SQLite so the repo runs with zero infrastructure; production uses PostgreSQL
// (rewrite the datasource in CI/Docker). SQLite does not support native enums, so enum-like
// fields are String with TypeScript union types in packages/types — same values as the spec.
// Money is integer pence (BigInt). Areas are sqft.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

// ---- Tenancy & people ----
model Organisation {
  id        String     @id @default(cuid())
  name      String
  logoUrl   String     @default("") // firm mark on client-facing documents
  plan      String     @default("TRIAL") // TRIAL | STARTER | GROWTH | ENTERPRISE
  // When the trial stops. Null on a paid plan, and null on the demo workspace.
  // A trial with no clock is a free tier nobody decided to offer.
  trialEndsAt DateTime?
  stripeCustomerId String?
  stripeSubscriptionId String?
  // Contributing a client's appraisal ratios to a shared pool is a decision a
  // firm makes deliberately — the underlying figures are client-confidential —
  // so it is off until somebody with authority turns it on. Reading cohorts is
  // NOT gated on contributing: making a paid feature conditional on sharing
  // client data would be pressure dressed up as reciprocity.
  contributesBenchmarks Boolean @default(false)
  users     User[]
  deals     Deal[]
  contractors Contractor[]
  investors Investor[]
  createdAt DateTime   @default(now())
}

model User {
  id        String   @id @default(cuid())
  orgId     String
  org       Organisation @relation(fields: [orgId], references: [id])
  email     String   @unique
  password  String   // demo: plain seed value hashed with sha256; swap for Auth.js in prod
  name      String
  role      String   @default("ANALYST") // ADMIN | ANALYST | SURVEYOR | VIEWER
  principalType String @default("internal") // internal | buyer | investor
  initials  String
  investorId String? // set when principalType=investor
  buyerUnitId String? // set when principalType=buyer
  // Password reset. The token is stored HASHED: a leaked database row must not be
  // a working reset link, and this table is exactly what leaks.
  resetTokenHash      String?
  resetTokenExpiresAt DateTime?
  deals     Deal[]
  createdAt DateTime @default(now())
}

// ---- Deals / pipeline ----
model Deal {
  id           String  @id @default(cuid())
  orgId        String
  org          Organisation @relation(fields: [orgId], references: [id])
  name         String
  address      String
  postcode     String?
  assetType    String  // INDUSTRIAL | RESIDENTIAL | COMMERCIAL | MIXED_USE
  stage        String  @default("SOURCING") // SOURCING | APPRAISAL | OFFER | ACQUISITION | CONSTRUCTION | SALES_LETTING | COMPLETED
  figureStatus String  @default("ESTIMATE") // ESTIMATE | COMMITTED | ACTUAL
  probability  Int     @default(50)
  gdv          BigInt  @default(0) // pence
  forecastProfit BigInt @default(0)
  roc          Float   @default(0)
  equityRequired BigInt @default(0)
  viability    String  @default("CAUTION") // PROCEED | CAUTION | DECLINE
  nextMilestone String?
  nextMilestoneDate DateTime?
  ownerId      String?
  owner        User?   @relation(fields: [ownerId], references: [id])
  appraisals   Appraisal[]
  engagement   EngagementTerms?
  units        Unit[]
  tenancies    Tenancy[]
  comparables  Comparable[]
  scenarios    Scenario[]
  inspections  Inspection[]
  costPackages CostPackage[]
  sitePhotos   SitePhoto[]
  documents    Document[]
  tasks        Task[]
  holdings     Holding[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([orgId, stage])
}

// ---- Appraisal (inputs; results derived by the engine, cached) ----
model Appraisal {
  id         String  @id @default(cuid())
  orgId      String
  dealId     String
  deal       Deal    @relation(fields: [dealId], references: [id])
  isCurrent  Boolean @default(true)
  label      String  @default("Base")
  // why this version exists, in the author's words. The diff says WHAT moved;
  // only the person who moved it can say why, and that is the half a reviewer
  // cannot reconstruct later.
  note       String?
  // Review state: draft | in_review | approved | changes_requested.
  // An approval attaches to a VERSION, never to the deal — approving "the
  // appraisal" means nothing if the thing approved can change afterwards.
  reviewStatus   String    @default("draft")
  submittedById  String?
  submittedAt    DateTime?
  reviewedById   String?
  reviewedAt     DateTime?
  reviewNote     String?
  source     String  @default("manual") // manual | ai | field
  efficiency Float   @default(90)
  units      String  // JSON AppraisalUnit[] {label,count,area,cap,conf,source} — cap in £/sqft
  trades     String  // JSON BuildTrade[] {label, rate £/ft²}
  otherCosts String  // JSON {label, amount pence}[]
  profFeePct Float   @default(11)
  contingencyPct Float @default(5)
  ltcPct     Float   @default(60)
  ratePct    Float   @default(7.5)
  periodMonths Int   @default(18)
  salesMonths Int    @default(3)
  arrangementFeePct Float @default(1.5)
  drawFactorPct Float @default(55)
  absorptionUnitsPerMonth Float? // optional sales absorption (units/month)
  spendProfile String @default("SCURVE") // SCURVE | EVEN | FRONT | BACK
  mezzToPct  Float?
  mezzRatePct Float?
  siteMode   String  @default("RESIDUAL") // RESIDUAL | PROFIT
  landFixed  BigInt  @default(0) // pence
  acqPct     Float   @default(6.8)
  agentPct   Float   @default(1.5)
  legalPct   Float   @default(0.5)
  targetProfitOnGdvPct Float @default(20)
  jvGpCoinvestPct Float @default(10)
  jvPrefPct  Float   @default(8)
  jvPromotePct Float @default(20)
  planningStatus String?
  cilPerSqm  Float   @default(0)
  s106       BigInt  @default(0) // pence
  planningRisk Int?
  startYear  Int?
  startMonth Int?
  phases     String? // JSON Phase[] — phased programme; when set it owns the accommodation
  dcf        String? // JSON DcfInput — growth-explicit cross-check on the capitalisation
  income     String? // JSON IncomeInput — held-and-let element valued by the investment method (rent in £/ft²/yr)
  resultCache String?
  narrative  String? // JSON {marketCommentary, valuationRationale, riskCommentary, generatedAt, model}
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([dealId, isCurrent])
}

// ---- Comparables ----
model Comparable {
  id      String @id @default(cuid())
  orgId   String
  dealId  String
  deal    Deal   @relation(fields: [dealId], references: [id])
  address String
  meta    String @default("")
  basePsf Float
  adjSize Float  @default(0)
  adjCondition Float @default(0)
  adjDate Float  @default(0)
  adjLocation Float @default(0)
  lat     Float?
  lng     Float?

  @@index([dealId])
}

// ---- Scenarios ----
model Scenario {
  id      String @id @default(cuid())
  orgId   String
  dealId  String
  deal    Deal   @relation(fields: [dealId], references: [id])
  name    String
  descriptor String @default("")
  blendedPsf Float
  buildPsf Float
  gia     Int
  targetProfitPct Float

  @@index([dealId])
}

// ---- Field inspection ----
model Inspection {
  id         String @id @default(cuid())
  orgId      String
  dealId     String
  deal       Deal   @relation(fields: [dealId], references: [id])
  surveyorId String?
  inspectedAt DateTime?
  rooms      String // JSON {name, condition, photos[], notes}[]
  reconciledValue BigInt?
  approachWeights String // JSON {salesComparison, cost, income}
  status     String @default("draft")

  @@index([dealId])
}

// ---- Sales & lettings ----
model Unit {
  id      String @id @default(cuid())
  orgId   String
  dealId  String
  deal    Deal   @relation(fields: [dealId], references: [id])
  name    String
  spec    String
  level   Int    @default(0)
  appraisedValue BigInt // pence
  agreedValue BigInt?
  status  String @default("AVAILABLE") // AVAILABLE | RESERVED | EXCHANGED | COMPLETED | HANDOVER
  buyerName String?
  buyerSolicitor String?
  leadSource String?
  incentive String?
  depositHeld BigInt?
  reservedAt DateTime?
  progress Int   @default(0) // 0-7 conveyancing milestone index
  stalled Boolean @default(false)
  milestones SalesMilestone[]

  @@index([dealId, status])
}

model SalesMilestone {
  id     String @id @default(cuid())
  unitId String
  unit   Unit   @relation(fields: [unitId], references: [id])
  name   String
  index  Int
  done   Boolean @default(false)
  date   DateTime?
}

model Tenancy {
  id      String @id @default(cuid())
  orgId   String
  dealId  String
  deal    Deal   @relation(fields: [dealId], references: [id])
  name    String
  spec    String
  level   Int    @default(0)
  ervPcm  BigInt // pence
  agreedRentPcm BigInt?
  tenantName String?
  leadSource String?
  incentive String?
  status  String @default("AVAILABLE") // AVAILABLE | APPLICATION | REFERENCING | SIGNED | OCCUPIED
  progress Int   @default(0) // 0-5 letting milestone index
  appliedAt DateTime?
  stalled Boolean @default(false)
  arrears BigInt @default(0)

  @@index([dealId, status])
}

// ---- Construction cost monitoring ----
model Contractor {
  id     String @id @default(cuid())
  orgId  String
  org    Organisation @relation(fields: [orgId], references: [id])
  name   String
  trade  String
  status String @default("On site")
  rating String @default("—")
  nextCert String @default("—")
  retentionRelease String @default("50% at PC")
  timesheetRate BigInt? // pence/day
  operatives Int?
  weeks  String // JSON hours[] sparkline
  packages CostPackage[]
  photos SitePhoto[]
}

model CostPackage {
  // manual | xero — a package fed by the ledger is not one a person maintains,
  // and the sync must never overwrite what a quantity surveyor typed
  source   String @default("manual")
  id       String @id @default(cuid())
  orgId    String
  dealId   String
  deal     Deal   @relation(fields: [dealId], references: [id])
  name     String
  budget   BigInt // pence
  committed BigInt @default(0)
  spent    BigInt @default(0)
  forecast BigInt
  retentionPct Float @default(5)
  certificates Int @default(0)
  progressPct Int @default(0)
  contractorId String?
  contractor Contractor? @relation(fields: [contractorId], references: [id])

  @@index([dealId])
}

model SitePhoto {
  id      String @id @default(cuid())
  orgId   String
  dealId  String
  deal    Deal   @relation(fields: [dealId], references: [id])
  caption String
  contractorId String?
  contractor Contractor? @relation(fields: [contractorId], references: [id])
  url     String @default("")
  takenAt DateTime
  weekCommencing DateTime

  @@index([dealId, weekCommencing])
}

// ---- Documents / data room ----
model Document {
  id       String @id @default(cuid())
  orgId    String
  dealId   String
  deal     Deal   @relation(fields: [dealId], references: [id])
  name     String
  category String // Architectural | Planning | Cost plans | Legal | Finance
  ext      String
  sizeBytes BigInt
  url      String @default("")
  extraction String @default("STORED") // EXTRACTED | LINKED | STORED
  buyerVisible Boolean @default(false)
  signedAt DateTime? // buyer e-sign timestamp (DocuSign in prod)
  addedById String?
  addedAt  DateTime @default(now())

  @@index([dealId, category])
}

// Firm-level standing wording: the AI policy note added to reports, and the
// house defaults new terms of engagement are drafted from. Blank fields fall
// back to Apex's built-in wording — nothing here can weaken the engine's own
// factual AI statement, which is not editable by design.
// Server faults, kept where they can be looked at.
//
// No external provider: a self-hosted deployment and a firm with a data-residency
// policy both need this to work without shipping their errors to a third party.
// The trade is retention and volume, both bounded below.
model ErrorEvent {
  id        String   @id @default(cuid())
  // null when the fault happened before a principal was resolved (a bad token,
  // an unauthenticated route) — those are exactly the ones worth seeing
  orgId     String?
  userId    String?
  method    String
  path      String
  statusCode Int
  code      String?
  message   String
  stack     String?
  // repeats of the same fault increment rather than insert: an error storm must
  // not be able to fill the database it is reporting on
  count     Int      @default(1)
  firstAt   DateTime @default(now())
  lastAt    DateTime @default(now())

  @@index([orgId, lastAt])
  @@index([path, message])
}

// A read-only link to a report, for someone with no account.
//
// It serves the rendered PDF, never a data API. That is the whole security
// design: an unauthenticated JSON endpoint over valuation inputs would be a much
// larger thing to get right, and nobody asked for one — they asked to send a
// lender the appraisal.
model ReportShare {
  id          String    @id @default(cuid())
  orgId       String
  dealId      String
  // appraisal | redbook
  kind        String
  // hashed, like a password reset: a leaked row must not be a working link
  tokenHash   String    @unique
  expiresAt   DateTime
  revokedAt   DateTime?
  createdById String
  createdAt   DateTime  @default(now())
  viewCount   Int       @default(0)
  lastViewedAt DateTime?

  @@index([orgId, dealId])
}

// A machine's credential for the public API.
//
// Hashed like every other secret here: the raw key is shown once at creation and
// cannot be produced again. `prefix` is stored in the clear ONLY so a screen can
// say which key is which — it is not enough to authenticate with.
model ApiKey {
  id          String    @id @default(cuid())
  orgId       String
  name        String
  // first characters, for identification in a list — never sufficient to auth
  prefix      String
  keyHash     String    @unique
  // "read" or "read,write" — write is deliberately opt-in
  scopes      String    @default("read")
  createdById String
  createdAt   DateTime  @default(now())
  lastUsedAt  DateTime?
  revokedAt   DateTime?

  @@index([orgId])
}

// Where this workspace wants to be told when something happens.
model WebhookEndpoint {
  id          String    @id @default(cuid())
  orgId       String
  url         String
  // shared secret for the signature; the receiver verifies with it
  secret      String
  // comma-separated event names this endpoint asked for
  events      String
  active      Boolean   @default(true)
  createdById String
  createdAt   DateTime  @default(now())
  lastAttemptAt DateTime?
  // consecutive failures — an endpoint that stops answering stops being tried
  failureCount Int      @default(0)

  deliveries  WebhookDelivery[]

  @@index([orgId])
}

model WebhookDelivery {
  id         String   @id @default(cuid())
  orgId      String
  endpointId String
  endpoint   WebhookEndpoint @relation(fields: [endpointId], references: [id])
  event      String
  payload    String
  status     String   @default("pending") // pending | delivered | failed
  attempts   Int      @default(0)
  responseCode Int?
  error      String?
  createdAt  DateTime @default(now())
  deliveredAt DateTime?

  @@index([orgId, createdAt])
  @@index([endpointId, status])
}

// A workspace's link to a Xero organisation.
//
// One row per Apex workspace. Tokens are stored because there is no other way to
// hold an OAuth session, and the refresh token is the sensitive one: it is a
// standing key to the customer's accounting system until revoked.
model XeroConnection {
  id           String    @id @default(cuid())
  orgId        String    @unique
  // Xero's own organisation id — a connection can span several, and the wrong
  // one silently reads another company's ledger
  tenantId     String
  tenantName   String
  accessToken  String
  refreshToken String
  expiresAt    DateTime
  scopes       String
  connectedById String
  connectedAt  DateTime  @default(now())
  lastSyncAt   DateTime?
  lastSyncError String?
  // Xero tracking category used to say which deal a bill belongs to
  trackingCategoryId   String?
  trackingCategoryName String?
}

// Which Xero tracking option maps to which deal.
model XeroDealMap {
  id             String @id @default(cuid())
  orgId          String
  dealId         String
  trackingOptionId   String
  trackingOptionName String

  @@unique([orgId, trackingOptionId])
  @@index([orgId, dealId])
}

// A firm's own identity provider.
//
// One per workspace. OIDC, so Microsoft Entra and Google Workspace are the same
// code path — a provider-specific implementation would be two things to keep
// correct and two places for a verification step to go missing.
model SsoConnection {
  id           String  @id @default(cuid())
  orgId        String  @unique
  // e.g. https://login.microsoftonline.com/<tenant>/v2.0
  issuer       String
  clientId     String
  clientSecret String
  // email domains this firm claims, comma-separated. A provider may assert any
  // address; only these are accepted into THIS workspace.
  domains      String
  // when true, password sign-in is refused for this workspace
  enforced     Boolean @default(false)
  // role given to someone signing in for the first time
  defaultRole  String  @default("ANALYST")
  createdById  String
  createdAt    DateTime @default(now())
  lastLoginAt  DateTime?
}

// A firm's bank feed, under UK Open Banking (PSD2).
//
// Xero says what suppliers INVOICED. This says what actually left the account,
// and what the lender actually advanced. Until now "drawn" in the funding pack
// was committed spend standing in for cash — a proxy a lender would not accept
// for long.
model BankConnection {
  id            String    @id @default(cuid())
  orgId         String    @unique
  provider      String    @default("truelayer")
  institution   String
  accessToken   String
  refreshToken  String
  expiresAt     DateTime
  // PSD2 account-information consent expires — 90 days is the UK norm — and the
  // feed goes silent when it does. Stored so the product can say so BEFORE it
  // stops rather than after.
  consentExpiresAt DateTime
  createdById   String
  createdAt     DateTime  @default(now())
  lastSyncAt    DateTime?
  lastSyncError String?

  accounts      BankAccount[]
}

model BankAccount {
  id           String  @id @default(cuid())
  orgId        String
  connectionId String
  connection   BankConnection @relation(fields: [connectionId], references: [id])
  // the provider's id for this account
  externalId   String
  name         String
  // last four only: a full account number has no business being stored to show
  // somebody which account they picked
  last4        String
  currency     String  @default("GBP")
  // which scheme this account funds, once someone says
  dealId       String?
  transactions BankTransaction[]

  @@unique([connectionId, externalId])
  @@index([orgId])
}

model BankTransaction {
  id         String   @id @default(cuid())
  orgId      String
  accountId  String
  account    BankAccount @relation(fields: [accountId], references: [id])
  // the provider's id, so re-syncing the same window cannot double-count
  externalId String
  bookedAt   DateTime
  // pence, signed: negative is money out
  amount     BigInt
  description String
  // what the firm has said this is, never what we guessed:
  // unclassified | drawdown | equity | receipt | cost
  classification String @default("unclassified")
  classifiedById String?

  @@unique([accountId, externalId])
  @@index([orgId, bookedAt])
}

model OrgPolicy {
  id    String @id @default(cuid())
  orgId String @unique

  aiPolicy String @default("")

  // Facility covenants, firm-wide. NULLABLE ON PURPOSE: an unset limit is not
  // tested, because a breach measured against a threshold nobody agreed to is an
  // accusation rather than a finding.
  covLtgdvMaxPct       Float?
  covLtcMaxPct         Float?
  covMinProfitOnCostPct Float?

  // terms-of-engagement house style
  toePurpose               String @default("")
  toeOtherUsers            String @default("")
  toeInterest              String @default("")
  toeExtentOfInvestigation String @default("")
  toeSourcesOfInformation  String @default("")
  toeAssumptions           String @default("")
  toeSpecialAssumptions    String @default("")
  toeReportFormat          String @default("")
  toeRestrictionsOnUse     String @default("")
  toeFeeBasis              String @default("")
  toeComplaintsProcedure   String @default("")
  toeValuerReg             String @default("")
  toeLiabilityCap          BigInt? // pence

  updatedAt DateTime @updatedAt
}

// Terms of engagement (RICS Red Book VPS 1) — the written agreement with the
// client that must exist BEFORE the valuation is reported. One record per deal;
// issuing freezes it and acceptance records who agreed and when.
model EngagementTerms {
  id       String @id @default(cuid())
  orgId    String
  dealId   String @unique
  deal     Deal   @relation(fields: [dealId], references: [id])
  status   String @default("DRAFT") // DRAFT | ISSUED | ACCEPTED

  // parties and instruction
  clientName     String
  clientAddress  String @default("")
  otherUsers     String @default("None. This report is for the addressee client only.")
  purpose        String
  interest       String // freehold / leasehold / part-freehold
  basisOfValue   String // Market Value | Market Rent | Fair Value | Investment Value
  valuationDate  DateTime?

  // scope
  extentOfInvestigation String
  sourcesOfInformation  String
  assumptions           String
  specialAssumptions    String
  reportFormat          String
  restrictionsOnUse     String

  // commercial terms
  feeBasis            String
  liabilityCap        BigInt? // pence; null = no stated cap
  complaintsProcedure String

  // AI use — stated up front, per RICS transparency requirements
  aiUse String

  valuerName String
  valuerReg  String

  issuedAt   DateTime?
  acceptedAt DateTime?
  acceptedBy String?

  // e-signature: the client opens /terms/<signToken> and signs; the evidence
  // trail (typed name, time, IP, user agent) is what makes it hold up later
  signToken       String?
  // a signing link is a bearer credential: it stops working on its own
  signTokenExpiresAt DateTime?
  signedName      String?
  signedAt        DateTime?
  signedIp        String?
  signedUserAgent String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId, status])
  // lookup index, deliberately NOT unique: a unique constraint makes the
  // boot-time `prisma db push` demand --accept-data-loss, and putting that flag
  // on a production start command is a worse trade than trusting 24 random bytes
  @@index([signToken])
}

model ActivityEvent {
  id     String @id @default(cuid())
  orgId  String
  // org-level events — a sign-in, an invite, a plan change — belong to no deal
  dealId String?
  // WHO, immutably. `actor` is the display name as it stood at the time, which is
  // what a reader wants to see; it is not an identity — people are renamed and
  // two of them can share a name. An audit trail that cannot survive a rename is
  // not evidence.
  userId String?
  actor  String
  action String
  target String
  ip     String?
  at     DateTime @default(now())

  @@index([dealId, at])
  @@index([orgId, at])
}

// ---- Tasks ----
model Task {
  id      String @id @default(cuid())
  orgId   String
  dealId  String
  deal    Deal   @relation(fields: [dealId], references: [id])
  title   String
  aspect  String
  assignee String @default("AO") // initials
  due     DateTime?
  done    Boolean @default(false)
  createdAt DateTime @default(now())

  @@index([orgId, dealId, done])
}

// ---- Investors ----
model Investor {
  id      String @id @default(cuid())
  orgId   String
  org     Organisation @relation(fields: [orgId], references: [id])
  name    String
  initials String @default("IN")
  contactFirst String @default("")
  sharePct Float @default(100) // of the LP base
  holdings Holding[]
  cashflows Cashflow[]
  documents String // JSON {name, date, size}[]
}

model Holding {
  id         String @id @default(cuid())
  investorId String
  investor   Investor @relation(fields: [investorId], references: [id])
  dealId     String
  deal       Deal @relation(fields: [dealId], references: [id])
  sharePct   Float
  committed  BigInt // pence — 100% LP basis, scale by investor share
  called     BigInt @default(0)
  distributed BigInt @default(0)
  irr        Float @default(0)
}

model Cashflow {
  id         String @id @default(cuid())
  investorId String
  investor   Investor @relation(fields: [investorId], references: [id])
  dealId     String?
  kind       String // dist | call
  label      String @default("")
  amount     BigInt // pence, signed on 100% basis
  date       DateTime
}

// ---- Buyer payments (Stripe when configured; demo mode otherwise) ----
model Payment {
  id       String @id @default(cuid())
  orgId    String
  unitId   String
  kind     String // "Reservation fee" | "Exchange deposit (10%)" | ...
  amount   BigInt // pence
  status   String @default("PENDING") // PENDING | PAID
  stripeIntentId String?
  paidAt   DateTime?
  createdAt DateTime @default(now())

  @@index([unitId, status])
}

// ---- Benchmarking (anonymised aggregate) ----
model BenchmarkPoint {
  id       String @id @default(cuid())
  region   String
  useClass String
  metric   String // buildPsf | gdvPsf | poc
  value    Float
  period   String // e.g. "2026-Q2"
  // 'contributed' — a real appraisal a firm chose to contribute, and the only
  // kind that may be presented as market evidence.
  // 'illustrative' — demonstration figures. Labelled as such wherever shown, and
  // never mixed into a contributed cohort: a valuer citing invented comparables
  // is a professional problem, not a cosmetic one.
  source   String @default("contributed")
  // the contributing firm. Null only for illustrative points. Kept so a cohort
  // can count DISTINCT contributors and exclude the reader's own figures.
  orgId    String?
  dealName String? // returned only to the contributing org, never to a cohort reader
  createdAt DateTime @default(now())

  @@index([region, useClass, metric])
  @@index([orgId])
}

// ---- Integrations ----
model IntegrationConnection {
  id       String @id @default(cuid())
  orgId    String
  provider String
  status   String @default("NOT_CONNECTED") // CONNECTED | ATTENTION | NOT_CONNECTED
  lastSync DateTime?
  config   String @default("{}") // provider credentials (JSON) — server-side only, never returned to clients
}

/// Public open-data responses, cached so a valuer does not wait on the Land
/// Registry twice for the same street. Deliberately NOT org-scoped: every row is
/// published public record keyed by postcode or rounded coordinates, identical
/// for every firm, and containing nothing a workspace owns. That also keeps it
/// out of the GDPR cascade and the workspace export, where it does not belong.
model OpenDataCache {
  key       String   @id
  source    String
  payload   String   // JSON, as everywhere else in this schema
  fetchedAt DateTime @default(now())

  @@index([fetchedAt])
}
